FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    INFERENCE_THREADS=1 \
    OMP_NUM_THREADS=1
WORKDIR /app

# LightGBM requires the GNU OpenMP shared library, absent in native Functions.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/
COPY app.py ./
COPY models/artifacts/best_model.pkl ./models/artifacts/best_model.pkl
COPY models/artifacts/training_metadata.json ./models/artifacts/training_metadata.json

# Fail the build if the actual trusted artifact cannot load in this runtime.
RUN python -c "import joblib; joblib.load('models/artifacts/best_model.pkl'); print('Trained model dependency check passed')"
EXPOSE 80
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "80"]
