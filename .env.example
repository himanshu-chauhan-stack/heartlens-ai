# Backend and Next.js server: keep API_KEY server-side.
APP_ENV=development
API_KEY=dev-api-key
API_URL=http://127.0.0.1:8000
# Native local development can use SQLite; Docker sets its own database URL.
DATABASE_URL=sqlite:///./heartlens.db
JWT_SECRET_KEY=local-development-secret-not-for-production
POSTGRES_PASSWORD=cardio
GROQ_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional direct API for static export only. Static sites cannot keep API secrets.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_PATH=/heartlens-ai
# Production requires independent strong secrets and a real HTTPS domain.
SITE_ADDRESS=
